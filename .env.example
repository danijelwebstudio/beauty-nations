# Build and runtime. Use the actual verified staging URL; do not switch DNS here.
NEXT_PUBLIC_SITE_URL=https://beauty-nations.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=info.lelapantelic@gmail.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
DEPLOYMENT_ENV=staging
# Build time: true ONLY in an authenticated review environment.
LEGAL_REVIEW_MODE=false

# Runtime only. Secret values belong in Coolify's protected environment settings.
FORMS_PROVIDER=formspree
FORMSPREE_FORM_ID=xqppnpgo
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=beauty-nations.vercel.app
# Leave blank until proxy overwrite and origin isolation have been verified.
# Supported: x-real-ip OR cf-connecting-ip; see DEPLOYMENT.md.
TRUSTED_CLIENT_IP_HEADER=
